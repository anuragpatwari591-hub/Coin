# Copy this file to `.env` and fill in real values. NEVER commit `.env`
# (it is already covered by the repo's .gitignore) and NEVER paste a real
# private key into any file that gets committed or shared.
#
# TESTNET ONLY. This project provides no mainnet deployment path — see
# blockchain/README.md.

# RPC endpoint for the Polygon Amoy testnet (chainId 80002). Get a free one
# from a provider such as Alchemy, Infura, or use the public default the
# config falls back to (https://rpc-amoy.polygon.technology) if unset.
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Private key of the deployer/testnet wallet used ONLY to deploy and to
# perform the one-time initial distribution transaction, funded with test
# MATIC from a faucet (e.g. https://faucet.polygon.technology/). Must be a
# 0x-prefixed 64-hex-character key. This wallet should hold no real funds,
# ever. Leave unset to compile/test locally without any deployment
# credentials configured.
DEPLOYER_PRIVATE_KEY=0xyour_testnet_only_private_key_here

# The address that will receive the entire fixed CHAI supply at
# deployment (the deployer/treasury-to-be, per TOKENOMICS.md). Defaults to
# the deployer's own address (derived from DEPLOYER_PRIVATE_KEY) if unset.
INITIAL_HOLDER_ADDRESS=0xyour_initial_holder_address_here

# The address set as the contract's initial Ownable owner (able only to
# transfer/renounce ownership — see ChaiCoin.sol). Defaults to the
# deployer's own address if unset.
INITIAL_OWNER_ADDRESS=0xyour_initial_owner_address_here

# API key from https://polygonscan.com/myapikey (works for Amoy via
# Polygonscan's unified API), used only for `npm run verify:amoy`.
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here

# Set after deployment (by you, or automatically read by verify.js from
# deployments/polygonAmoy.json — see scripts/deploy.js) so verify.js knows
# which address to verify. Optional: you can also pass it as CLI args.
CHAICOIN_ADDRESS=
CHAIVESTING_ADDRESS=
