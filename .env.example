# Root-level environment template. Copy to `.env` and fill in real values LOCALLY.
# NEVER commit a real .env file. See SECURITY.md for the full secret-management policy.
# Sub-projects (blockchain/, website/, backend/) have their own .env.example files
# with component-specific variables — this file only covers project-wide/shared values.

# --- General ---
PROJECT_ENV=development            # development | staging | testnet | production (production/mainnet requires explicit human sign-off — see ROADMAP.md mainnet gate)

# --- Analytics (fill in only with real, owned accounts; never fabricate) ---
# PLAUSIBLE_OR_GA_ID=
# GOOGLE_SEARCH_CONSOLE_VERIFICATION=

# --- Social/PR (optional, only when the team is ready to operate real accounts) ---
# TWITTER_API_KEY=
# TWITTER_API_SECRET=
# DISCORD_BOT_TOKEN=
# TELEGRAM_BOT_TOKEN=

# See blockchain/.env.example for chain/deployment-specific variables
# (RPC URLs, deployer private key placeholder, explorer API key placeholder).
